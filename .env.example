# Core runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////app/data/content_agent.db
RUN_LOCK_PATH=/app/data/pipeline.lock

# Daily schedule
SCHEDULER_ENABLED=true
TIMEZONE=Asia/Singapore
POST_TIME=09:00
CONTENT_MODE=mixed
MIXED_MODE_STRATEGY=importance

# Safety and approval
AUTO_PUBLISH=false
DRY_RUN=true
# Required when ENVIRONMENT=production. Use a long random value.
DASHBOARD_ADMIN_TOKEN=
MIN_VERIFICATION_CONFIDENCE=0.72
MIN_QUALITY_SCORE=85
MAX_POST_LENGTH=2800

# Collection and ranking
REQUEST_TIMEOUT_SECONDS=20
MAX_ARTICLES_PER_SOURCE=25
ARTICLE_MAX_AGE_HOURS=72
SIMILARITY_THRESHOLD=0.82
HISTORY_SIMILARITY_THRESHOLD=0.78
EXTRA_RSS_FEEDS=
GITHUB_TOKEN=
SCORE_RECENCY_WEIGHT=0.25
SCORE_SOURCE_QUALITY_WEIGHT=0.20
SCORE_IMPORTANCE_WEIGHT=0.20
SCORE_NOVELTY_WEIGHT=0.15
SCORE_TECHNICAL_RELEVANCE_WEIGHT=0.10
SCORE_SOCIAL_INTEREST_WEIGHT=0.10

# LLM: template runs locally and is the zero-secret acceptance-test default.
# To use DeepSeek, set LLM_PROVIDER=deepseek and DEEPSEEK_API_KEY.
LLM_PROVIDER=template
CONTENT_STYLE=professional
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1800
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional alternative providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=

# Optional image generation through a separate compatible images endpoint
IMAGE_GENERATION_ENABLED=false
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024

# Publication adapters. Example: telegram,webhook
PUBLISH_PLATFORMS=
WEBHOOK_URL=
WEBHOOK_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWITTER_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202510
